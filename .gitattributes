# Normaliza finais de linha: tudo em LF no repositório (evita CRLF do Windows quebrar scripts).
* text=auto eol=lf

# Scripts do Windows precisam de CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Arquivos binários: nunca converter.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.webp binary
*.jar binary
*.keystore binary
*.jks binary
*.ttf binary
*.otf binary
