# Modelo das variáveis de ambiente do projeto.
# Copie para ".env" e preencha os valores reais (o ".env" NÃO vai para o Git).
#
# No momento o app não usa nenhuma variável de ambiente: as palavras ficam
# fixas em lib/main.dart e não há chamadas a APIs externas.
# Se no futuro o app usar uma API de tradução, declare aqui só o NOME, por exemplo:
#
# TRANSLATION_API_URL=
# TRANSLATION_API_KEY=
